<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>
  <groupId>dev.doc2tex</groupId>
  <artifactId>doc2tex</artifactId>
  <version>0.1.0</version>
  <name>doc2TeX</name>
  <description>A local DOCX to LaTeX workspace</description>
  <url>https://github.com/braces157/doc2tex</url>
  <licenses><license><name>MIT License</name><url>https://opensource.org/license/mit/</url></license></licenses>
  <scm>
    <url>https://github.com/braces157/doc2tex</url>
    <connection>scm:git:https://github.com/braces157/doc2tex.git</connection>
  </scm>
  <properties>
    <java.version>21</java.version>
    <doc2tex.build-directory>target</doc2tex.build-directory>
  </properties>
  <dependencies>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-webmvc</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-validation</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.apache.pdfbox</groupId><artifactId>pdfbox</artifactId><version>3.0.8</version><scope>test</scope></dependency>
  </dependencies>
  <build>
    <directory>${doc2tex.build-directory}</directory>
    <resources>
      <resource><directory>src/main/resources</directory></resource>
      <resource><directory>frontend/dist</directory><targetPath>static</targetPath></resource>
      <resource><directory>LICENSES</directory><targetPath>META-INF/licenses</targetPath></resource>
      <resource><directory>.</directory><includes><include>LICENSE</include><include>THIRD_PARTY_NOTICES.md</include></includes><targetPath>META-INF</targetPath></resource>
    </resources>
    <plugins>
      <plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId></plugin>
    </plugins>
  </build>
</project>
