# Copy this file to .env and fill in your private Cloudflare Tunnel token.
# Never commit .env to Git.
CLOUDFLARE_TUNNEL_TOKEN=
DOC2TEX_ALLOWED_HOSTS=doc2tex.tech,www.doc2tex.tech

